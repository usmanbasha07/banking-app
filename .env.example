# =========================================================
#  .env.example — Environment Variable Template
#  -------------------------------------------------------
#  INSTRUCTIONS:
#  1. Copy this file:   cp .env.example .env
#  2. Fill in real values in .env
#  3. NEVER commit .env to Git (it is already in .gitignore)
#  -------------------------------------------------------
#  This file IS safe to commit — it contains no real secrets.
# =========================================================

# ---------------------------------------------------------
# SPRING / APP
# ---------------------------------------------------------

# Which profile to activate: dev | stage | prod
SPRING_PROFILES_ACTIVE=dev

# Application listening port
# dev=8080, stage=8081, prod=8082 (defaults in each profile)
SERVER_PORT=8080

# ---------------------------------------------------------
# DATABASE (not needed for 'dev' profile — H2 is used)
# ---------------------------------------------------------

# Hostname of your MySQL server
DB_HOST=localhost

# MySQL port (default 3306)
DB_PORT=3306

# Database schema name
# stage example: banking_stage_db
# prod  example: banking_prod_db
DB_NAME=banking_app

# Database user
DB_USERNAME=root

# Database password — KEEP THIS SECRET
DB_PASSWORD=your_strong_password_here

# ---------------------------------------------------------
# JPA / HIBERNATE
# ---------------------------------------------------------

# DDL strategy:
#   dev   → create-drop  (recreates DB on each restart)
#   stage → update       (auto-alters schema)
#   prod  → validate     (never modifies schema — safest)
JPA_DDL_AUTO=update

# Show SQL queries in logs (true for dev/stage, false for prod)
JPA_SHOW_SQL=true

# ---------------------------------------------------------
# LOGGING
# ---------------------------------------------------------

# Root log level: TRACE | DEBUG | INFO | WARN | ERROR
# dev=DEBUG, stage=INFO, prod=WARN
LOG_LEVEL=DEBUG
